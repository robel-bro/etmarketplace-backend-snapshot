<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Invoice #<%= @order.id %></title>
  <style>
    /* Same CSS as show.pdf.erb (exactly) */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      color: #333;
      font-size: 13px;
      line-height: 1.4;
    }
    .header {
      background: #1a1a2e;
      color: #ffffff;
      padding: 30px 40px;
      position: relative;
      overflow: hidden;
    }
    .header::after {
      content: "";
      position: absolute;
      right: -20px; top: -20px;
      width: 200px; height: 200px;
      background: rgba(255,255,255,0.05);
      border-radius: 50%;
    }
    .header .logo {
      font-size: 28px; font-weight: 800; letter-spacing: 2px;
    }
    .header .invoice-title {
      font-size: 36px; font-weight: 700; margin-top: 10px; letter-spacing: 1px;
    }
    .header .invoice-number {
      font-size: 16px; margin-top: 5px; opacity: 0.9;
    }
    .info-section {
      padding: 30px 40px;
      background: #f8f9fa;
      border-bottom: 1px solid #dee2e6;
    }
    .info-grid {
      display: flex; justify-content: space-between; flex-wrap: wrap;
    }
    .info-box {
      width: 48%; margin-bottom: 20px;
    }
    .info-box h3 {
      font-size: 12px; text-transform: uppercase; letter-spacing: 2px;
      color: #6c757d; margin-bottom: 8px;
    }
    .info-box p {
      font-size: 14px; line-height: 1.5;
    }
    .items-table {
      width: 100%; border-collapse: collapse; margin: 30px 0; padding: 0 40px;
    }
    .items-table th {
      background: #1a1a2e; color: #ffffff; text-transform: uppercase;
      font-size: 11px; letter-spacing: 1px; padding: 12px 15px; text-align: left;
    }
    .items-table th:last-child, .items-table td:last-child {
      text-align: right;
    }
    .items-table td {
      padding: 14px 15px; border-bottom: 1px solid #dee2e6; font-size: 14px;
    }
    .items-table tr:nth-child(even) td { background: #f8f9fa; }
    .items-table .item-name { font-weight: 600; }
    .items-table .item-qty { color: #6c757d; }
    .totals {
      margin: 20px 40px; width: 300px; float: right;
    }
    .totals table { width: 100%; }
    .totals td { padding: 6px 0; font-size: 14px; }
    .totals .total-row {
      font-size: 20px; font-weight: 700; border-top: 2px solid #1a1a2e; padding-top: 10px;
    }
    .totals .label { color: #6c757d; }
    .totals .value { text-align: right; }
    .footer {
      clear: both; padding: 30px 40px; text-align: center;
      border-top: 1px solid #dee2e6; color: #6c757d; font-size: 12px; margin-top: 40px;
    }
    .thank-you {
      font-size: 16px; font-weight: 600; color: #1a1a2e; margin-bottom: 10px;
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="logo"><%= @company_name %></div>
    <div class="invoice-title">INVOICE</div>
    <div class="invoice-number">#<%= @order.id %></div>
  </div>

  <div class="info-section">
    <div class="info-grid">
      <div class="info-box">
        <h3>Bill To</h3>
        <p>
          <strong><%= @order.user.try(:full_name) || @order.user.try(:name) || @order.user.try(:email) %></strong><br>
          <%= @order.user.try(:email) %><br>
          <%= @order.shipping_address %>
        </p>
      </div>
      <div class="info-box">
        <h3>Invoice Details</h3>
        <p>
          <strong>Invoice Number:</strong> #<%= @order.id %><br>
          <strong>Invoice Date:</strong> <%= l(@order.created_at.to_date, format: :long) %><br>
          <strong>Due Date:</strong> <%= l((@order.created_at + 30.days).to_date, format: :long) %><br>
          <strong>Status:</strong>
          <span style="color: <%= @order.status == 'delivered' ? '#28a745' : '#dc3545' %>;">
            <%= @order.status.humanize %>
          </span>
        </p>
      </div>
      <div class="info-box">
        <h3>Seller</h3>
        <p>
          <%= @order.vendor.business_name %><br>
          <%= @order.vendor.business_address %>
        </p>
      </div>
      <div class="info-box">
        <h3>Payment Method</h3>
        <p>
          <%= @order.payment_method_enum.humanize %><br>
          Payment status: <%= @order.payment_status.humanize %>
        </p>
      </div>
    </div>
  </div>

  <table class="items-table" style="margin-left:40px; margin-right:40px;">
    <thead>
      <tr>
        <th>Item</th>
        <th>Qty</th>
        <th>Unit Price</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      <% @order_items.each do |item| %>
        <tr>
          <td class="item-name"><%= item.product.title %></td>
          <td class="item-qty"><%= item.quantity %></td>
          <td><%= number_to_currency(item.price, unit: 'ETB ', precision: 2) %></td>
          <td><%= number_to_currency(item.price * item.quantity, unit: 'ETB ', precision: 2) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="totals">
    <table>
      <tr>
        <td class="label">Subtotal</td>
        <td class="value"><%= number_to_currency(@order.line_items.sum { |li| li.price * li.quantity }, unit: 'ETB ', precision: 2) %></td>
      </tr>
      <% if @order.shipping_cost > 0 %>
      <tr>
        <td class="label">Shipping</td>
        <td class="value"><%= number_to_currency(@order.shipping_cost, unit: 'ETB ', precision: 2) %></td>
      </tr>
      <% end %>
      <tr class="total-row">
        <td>Total</td>
        <td class="value"><%= number_to_currency(@order.total, unit: 'ETB ', precision: 2) %></td>
      </tr>
    </table>
  </div>

  <div class="footer">
    <div class="thank-you">Thank you for your purchase!</div>
    <p>If you have any questions, contact us at <%= @company_email %></p>
    <p style="margin-top:5px;"><%= @company_name %> – All rights reserved.</p>
  </div>
</body>
</html>